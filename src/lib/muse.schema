// The muse client database, authored in the OpenSchema DSL. Every table is kind
// "data" (the default), so the server injects + enforces a hidden subject_user_id
// scoping all rows to the signed-in user. Column names are the snake_case of each
// field (projectId -> project_id). Canvas objects live in one `object` table:
// positional/queried fields are columns, everything type-specific is JSON `payload`.
namespace muse

// One row per project; canvas objects reference it via object.project_id.
model Project {
  1 name: string
  2 color: string?
  3 createdAt: timestamp
  4 updatedAt: timestamp
}

model Object {
  // `type` is a reserved DSL keyword; keep the column name via @sql.column.
  @sql.column("type") 1 objectType: string
  2 x: f64?
  3 y: f64?
  4 parentId: string?
  5 zIndex: i64?
  6 projectId: string?
  7 payload: json
  8 updatedAt: timestamp
}

// One row per chat thread. Messages + branch metadata live in payload.
model AiThread {
  1 name: string
  2 payload: json
  3 updatedAt: timestamp
}

model AiMemory {
  1 content: string
  2 createdAt: timestamp
}
